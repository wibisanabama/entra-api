# Entra — Environment Configuration
# Copy this file to .env and fill in the values

# ─── Global Environment ──────────────────────
APP_ENV=development
INTERNAL_SERVICE_SECRET=entra-super-secret-internal-token-change-in-production

# ─── PostgreSQL ──────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=entra
POSTGRES_PASSWORD=entra_secret
POSTGRES_DB_AUTH=entra_auth
POSTGRES_DB_EVENT=entra_event
POSTGRES_DB_TICKET=entra_ticket
POSTGRES_DB_PAYMENT=entra_payment
POSTGRES_DB_CASHLESS=entra_cashless
POSTGRES_DB_GATE=entra_gate
POSTGRES_SSLMODE=disable

# ─── Redis ───────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Kafka ───────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ─── MinIO / Storage ─────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=entra_minio
MINIO_ROOT_PASSWORD=entra_minio_secret
STORAGE_PUBLIC_URL=http://localhost:9000

# ─── Auth Service ────────────────────────────
AUTH_SERVICE_PORT=8081
JWT_SECRET=change-me-to-a-strong-secret-key
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# ─── Event Service ───────────────────────────
EVENT_SERVICE_PORT=8082

# ─── Ticket Service ──────────────────────────
TICKET_SERVICE_PORT=8083
EVENT_SERVICE_URL=http://localhost:8082
AUTH_SERVICE_URL=http://localhost:8081

# ─── Payment Service ─────────────────────────
PAYMENT_SERVICE_PORT=8084

# ─── Cashless Service ────────────────────────
CASHLESS_SERVICE_PORT=8085

# ─── Gate Service ────────────────────────────
GATE_SERVICE_PORT=8086
TICKET_SERVICE_URL=http://localhost:8083

# ─── Storage Service ─────────────────────────
STORAGE_SERVICE_PORT=8087
